# Environment for the "sandbox" copy of the app, served through the proxy.
ENVIRONMENT="sandbox"
PROOF="The sandbox is for children"

# Prisma database connection string (path is relative to prisma/).
# Keep the SQLite provider in prisma/schema.prisma when using SQLite.
DATABASE_URL="file:sandbox.sqlite"

# Local port this instance binds to. The proxy forwards here.
PORT=3002
HMR_PORT=64992

# Whiplash (Ryder) OAuth connection — sandbox instance talks to Whiplash testing.
WHIPLASH_BASE_URL="https://sandbox.whiplash.app/"
WHIPLASH_CLIENT_ID="LorAWKk_fwOdjTRUlCFri86KM8aurOWAaWl0PHNvRV0"
WHIPLASH_CLIENT_SECRET="2NaqFN1FWRBSYRdpFlCwcLu4fTAQ3-kBpOfPKzhjP5E"
WHIPLASH_SCOPES="app_manage user_manage"
# Must exactly match the redirect URI registered on the sandbox Whiplash OAuth app.
# The ?env=sandbox marker lets the proxy route this shopless callback to this instance.
WHIPLASH_REDIRECT_URI="https://todd-shop-proxy-external.ngrok.io/whiplash/callback?env=sandbox"
# 32-byte key (hex or base64) used to encrypt stored Whiplash tokens at rest.
WHIPLASH_TOKEN_ENC_KEY="b62e7396347e98d67f8a8fed1bb6963477dc790785208ee6d207f4112508b655"
