# Environment for the "production" copy of the app, served through the proxy.
ENVIRONMENT="production"
PROOF="More stable than a 3 legged stool"

# Prisma database connection string (path is relative to prisma/).
# Keep the SQLite provider in prisma/schema.prisma when using SQLite.
DATABASE_URL="file:prod.sqlite"

# Local port this instance binds to. The proxy forwards here.
PORT=3001
HMR_PORT=64991

# Whiplash (Ryder) OAuth connection — production instance talks to Whiplash prod.
WHIPLASH_BASE_URL="https://stable.whiplash.app/"
WHIPLASH_CLIENT_ID="G97wd4P5gIed10JWdgvMAVNz1qlje9jmjuxg6RqbGeU"
WHIPLASH_CLIENT_SECRET="xgZT60AFXpn60R-286RghyvPgfWtp3-pK60DduJTM5Y"
WHIPLASH_SCOPES="app_manage user_manage"
# Must exactly match the redirect URI registered on the production Whiplash OAuth app.
WHIPLASH_REDIRECT_URI="https://todd-shop-proxy-external.ngrok.io/whiplash/callback"
# 32-byte key (hex or base64) used to encrypt stored Whiplash tokens at rest.
WHIPLASH_TOKEN_ENC_KEY="02b7f779257f4d78b4f0f2a50f31c4341e97a48a272e4ccaf90ae9ae40504882"

